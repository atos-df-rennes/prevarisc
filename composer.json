{
    "name": "sdis62/prevarisc",
    "description": "Application web open-source gérant l'ensemble de l'activité du service prévention au sein d'un SDIS.",
    "keywords": [
        "sdis62",
        "prevarisc",
        "prevention"
    ],
    "homepage": "https://github.com/SDIS62/prevarisc",
    "license": "CECILL-B",
    "require": {
        "php": "~7.1.0",
        "zendframework/zendframework1": "^1.0",
        "cybermonde/odtphp": "^1.0",
        "michelf/php-markdown": "^1.0",
        "sdis62/toolbox": "dev-master",
        "sebastian/git": "^2.0",
        "sabre/vobject": "~4",
        "jasig/phpcas": "~1.4.0",
        "phpoffice/phpexcel": "^1.8",
        "imagine/imagine": "^1.5",
        "symfony/dotenv": "^4.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.0"
    },
    "scripts": {
        "cs-check": "tools/vendor/bin/rector --dry-run && tools/vendor/bin/php-cs-fixer fix --dry-run",
        "cs-fix": "tools/vendor/bin/rector && tools/vendor/bin/php-cs-fixer fix",
        "analyse": "tools/vendor/bin/phpstan analyse --memory-limit=-1",
        "generate-baseline": "tools/vendor/bin/phpstan --memory-limit=-1 --generate-baseline",
        "test": "vendor/bin/phpunit --bootstrap tests/bootstrap/indexTest.php --testdox tests/",
        "test-coverage": "@test --coverage-html tests/coverage/ --whitelist application/",
        "changelog": "tools/vendor/bin/conventional-changelog",
        "release": "tools/vendor/bin/conventional-changelog --commit"
    },
    "version": "2.8.12"
}
<div id="reponse-modal" class="modal hide fade"></div>


<br>

<script type="text/javascript">
    $(document).ready(function() {
        // Gestion des boites modales
        $("a[data-toggle='modal']").click(function() {
            var target = $(this).attr("data-target");
            var url = $(this).attr("href");
            $(target).load(url);
        });

        $('.panel').show();

        // Gestion de l'ouverture de modale via le bouton "Ouvrir"
        $(document).on('click', '.btn-ouvrir', function(e) {
            e.preventDefault();

            var $panel = $(this).closest('.panel');
            var blocId = $panel.attr('id');

            // Afficher un loader dans la modale
            $('#reponse-modal').html('<div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h3>Chargement...</h3></div><div class="modal-body text-center"><img src="/images/load.gif" /></div>');
            $('#reponse-modal').modal('show');

            // Charger le contenu du bloc via l'action existante
            $.ajax({
                url: '/index/bloc',
                type: 'GET',
                data: {
                    id: blocId
                },
                success: function(response) {
                    // Récupérer le titre du bloc
                    var blocTitle = $panel.find('.panel-heading').clone();
                    blocTitle.find('.compteur').remove();
                    var title = blocTitle.text().trim();

                    // Construire le contenu de la modale
                    var modalContent = '<div class="modal-header">' +
                        '<button type="button" class="close" data-dismiss="modal">&times;</button>' +
                        '<h3>' + title + '</h3>' +
                        '</div>' +
                        '<div class="modal-body">' +
                        response +
                        '</div>';

                    $('#reponse-modal').html(modalContent);
                },
                error: function() {
                    $('#reponse-modal').html('<div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h3>Erreur</h3></div><div class="modal-body"><div class="alert alert-error">Une erreur est survenue lors du chargement des données.</div></div>');
                }
            });
        });

        $(document).ready(function () {
            // Filtrage
            function filtrerEtTrierCartes() {
                const searchValue = $('#filtre-cartes-search').val().toLowerCase();
                const typeFiltre = $('input[name="filtre-type"]:checked').val();

                $('.blocs-container').each(function () {
                    $(this).children().each(function () {
                        const card = $(this);
                        const titre = card.text().toLowerCase();
                        const type = card.data('type');

                        const correspondRecherche = titre.includes(searchValue);

                        let correspondType = false;

                        if (typeFiltre === 'tous') {
                            correspondType = true;
                        } else if (typeFiltre === 'autres') {
                            correspondType = (type !== 'dossiers' && type !== 'etablissements');
                        } else {
                            correspondType = type === typeFiltre;
                        }

                        if (correspondRecherche && correspondType) {
                            card.show();
                        } else {
                            card.hide();
                        }
                    });
                });

                // Afficher uniquement le titre de la section correspondante
                $('.titre-section').each(function () {
                    const section = $(this);
                    const sectionType = section.data('type');

                    if (typeFiltre === 'tous') {
                        section.show();
                    } else if (typeFiltre === 'autres') {
                        if (sectionType === 'dossiers' || sectionType === 'etablissements') {
                            section.hide();
                        } else {
                            section.show();
                        }
                    } else {
                        if (sectionType === typeFiltre) {
                            section.show();
                        } else {
                            section.hide();
                        }
                    }
                });
            }

            $('#filtre-cartes-search').on('input', filtrerEtTrierCartes);
            $('input[name="filtre-type"]').on('change', filtrerEtTrierCartes);
        });

        // Vérification de la connexion à Plat'AU
        <?php if (!filter_var(getenv('PREVARISC_DEACTIVATE_PLATAU'), FILTER_VALIDATE_BOOLEAN) && !filter_var(getenv('PREVARISC_PLATAU_NO_HEALTHCHECK'), FILTER_VALIDATE_BOOLEAN)): ?>
            $.ajax({
                type: 'GET',
                url: '/index/platau-healthcheck',
                beforeSend: function() {
                    $("#bloc__connexion-platau").html("Vérification de la connexion à Plat'AU <img src='/images/load.gif' />");
                },
                success: function(result) {
                    const res = JSON.parse(result)

                    if (res.healthcheckOk) {
                        $("#bloc__connexion-platau").html(`<div class="alert alert-info">
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                            <strong>La connexion à Plat'AU a fonctionnée.</strong>
                        </div>`)
                    } else {
                        if (res.errorOrigin === 'prevarisc') {
                            $("#bloc__connexion-platau").html(`<div class="alert alert-block alert-error">
                                <button type="button" class="close" data-dismiss="alert">&times;</button>
                                <h4>La connexion à Plat'AU depuis Prevarisc a échouée.</h4>
                                Veuillez suivre les instructions du Manuel Utilisateur §6.17.2
                            </div>`)
                        } else if (res.errorOrigin === 'PlatAU') {
                            $("#bloc__connexion-platau").html(`<div class="alert alert-block alert-error">
                                <button type="button" class="close" data-dismiss="alert">&times;</button>
                                <h4>Plat'AU est en erreur.</h4>
                                Veuillez réessayer ultérieurement.
                            </div>`)
                        }
                    }
                },
                error: function() {
                    $("#bloc__connexion-platau").html(`<div class="alert alert-error">
                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                        <strong>Une erreur s'est produite lors de la vérification de la connexion à Plat'AU.</strong>
                    </div>`);
                },
            })
        <?php endif ?>
    });
</script>

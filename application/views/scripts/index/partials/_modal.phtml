<div id="reponse-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>
    </div>
</div>

<br>

<script type="text/javascript">
    (function($) {
        'use strict';

        const CONFIG = {
            selectors: {
                modal: '#reponse-modal',
                modalContent: '.modal-content',
                sectionsContainer: '#sections-personnalisation',
                dashboardPanels: '.dashboard .panel:visible'
            },
            classes: {
                blocSortable: 'bloc-sortable',
                sectionPersonnalisation: 'section-personnalisation'
            }
        };

        const SECTIONS_CONFIG = {
            dossiers: {
                title: 'Dossiers',
                icon: 'icon-folder-close'
            },
            etablissements: {
                title: 'Établissements',
                icon: 'icon-th'
            },
            autres: {
                title: 'Messages, Courriers & Ordre du jour',
                icon: ''
            }
        };

        function determineSectionKey(type) {
            return (type === 'dossiers' || type === 'etablissements') ? type : 'autres';
        }

        function collecterBlocs() {
            const sections = {
                dossiers: { blocs: [], ...SECTIONS_CONFIG.dossiers },
                etablissements: { blocs: [], ...SECTIONS_CONFIG.etablissements },
                autres: { blocs: [], ...SECTIONS_CONFIG.autres }
            };

            $(CONFIG.selectors.dashboardPanels).each(function() {
                const $panel = $(this);
                const blocData = {
                    id: $panel.attr('id'),
                    type: $panel.data('type'),
                    titre: $panel.find('.panel-heading').clone().find('.compteur').remove().end().text().trim(),
                    compteur: $panel.find('.compteur').text().trim()
                };

                const sectionKey = determineSectionKey(blocData.type);
                if (sections[sectionKey]) {
                    sections[sectionKey].blocs.push(blocData);
                }
            });

            return sections;
        }

        function genererBlocHtml(bloc) {
            const compteurHtml = bloc.compteur
                ? `<span class="badge badge-info">${bloc.compteur}</span>`
                : '';

            return `
            <div class="${CONFIG.classes.blocSortable}"
                data-bloc-id="${bloc.id}"
                data-type="${bloc.type}"
                style="padding:5px; border:1px solid #ddd; margin-bottom:5px; background:#fff;">
                <i class="icon-move" style="margin-right:8px;"></i>
                <span class="bloc-titre">${bloc.titre}</span>
                ${compteurHtml}
            </div>
        `;
        }

        function genererSectionHtml(key, section) {
            const iconHtml = section.icon ? `<i class="${section.icon}"></i> ` : '';

            return `
            <div class="${CONFIG.classes.sectionPersonnalisation}" data-section="${key}">
                <h4>${iconHtml}${section.title}</h4>
                <div class="blocs-sortable" data-type="${key}"></div>
            </div>
        `;
        }

        function construireSections() {
            const $container = $(CONFIG.selectors.sectionsContainer);
            $container.empty();

            const sections = collecterBlocs();

            $.each(sections, function(key, section) {
                if (section.blocs.length === 0) return;

                $container.append(genererSectionHtml(key, section));

                const $blocsSortable = $container.find(`.blocs-sortable[data-type="${key}"]`);

                section.blocs.forEach(function(bloc) {
                    $blocsSortable.append(genererBlocHtml(bloc));
                });
            });
        }

        function genererContenuModal() {
            return `
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">&times;</button>
                <h3 class="modal-title">Personnaliser l'organisation des cartes</h3>
            </div>
            <div class="modal-body" id="modal-personnalisation-body">
                <div id="sections-personnalisation"></div>
            </div>
        `;
        }

        const ModalPersonnalisation = {
            ouvrir: function() {
                $(CONFIG.selectors.modal + ' ' + CONFIG.selectors.modalContent)
                    .html(genererContenuModal());

                construireSections();

                $(CONFIG.selectors.modal).modal('show');
            }
        };

        $(document).ready(function() {
            $('.filtre-cartes-personnaliser-btn').on('click', function(e) {
                e.preventDefault();
                ModalPersonnalisation.ouvrir();
            });
        });

    })(jQuery);
</script>

            <div class="select-all-container">
                <input type="checkbox" id="select-all-rubriques<?= $suffix ?>" checked>
                <label for="select-all-rubriques<?= $suffix ?>"><strong>Tous</strong></label>
            </div>

            <div class="search-bar">
                <input type="text" id="rubrique-search<?= $suffix ?>" placeholder="Rechercher..." autocomplete="off">
                <span class="search-icon"><i class = "icon-search"></i></span>
            </div>

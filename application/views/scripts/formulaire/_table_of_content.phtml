            <?php foreach ($this->rubriques as $index => $rubrique): ?>
                <div class="toc-item" data-index="<?= $index ?>">
                    <div class='descriptif-personnalise_rubriques-infos descriptif-personnalise_rubriques-infos--edit'>
                        <div id="rubrique-<?= $index ?><?= $suffix ?>" class="rubrique-section">
                            <?= $this->partial('formulaire/partials/partial-edit-rubrique-display.phtml', $rubrique); ?>
                        </div>
                    </div>
                </div>
            <?php endforeach ?>
        </div>
    </div>
</div>

<script>
        (function() {
            const suffix = '<?= $suffix ?>';
            const instance = document.querySelector(`[data-toc-instance="${suffix}"]`);

            if (!instance) return;

            const searchInput = instance.querySelector(`#rubrique-search${suffix}`);
            const selectAllCheckbox = instance.querySelector(`#select-all-rubriques${suffix}`);
            const tocItems = Array.from(instance.querySelectorAll('.toc-item'));
            const toggleIcon = instance.querySelector(`#toggle-sidebar${suffix}`);
            const sidebar = instance.closest('.toc-sidebar');

        function setRubriqueVisibility(id, visible) {
            const rubrique = document.querySelector(`main [id*="${id}"]`);
            if (rubrique) rubrique.style.display = visible ? 'block' : 'none';
        }

        function updateSelectAll() {
            const checkboxes = document.querySelectorAll('input[name^="afficher_rubrique-"]:not(:disabled)');
            const allChecked = Array.from(checkboxes).every(cb => cb.checked);
            selectAllCheckbox.checked = allChecked && checkboxes.length > 0;
        }

        document.querySelectorAll('input[name^="afficher_rubrique-"]').forEach(cb => {
            cb.addEventListener('change', () => {
                const id = cb.name.replace('afficher_rubrique-', '');
                setRubriqueVisibility(id, cb.checked);
                updateSelectAll();
            });
        });

        searchInput?.addEventListener('input', () => {
            const term = searchInput.value.toLowerCase();
            tocItems.forEach(item => {
                const match = item.textContent.toLowerCase().includes(term);
                item.style.display = match ? 'flex' : 'none';
            });
        });

        selectAllCheckbox?.addEventListener('change', () => {
            const checked = selectAllCheckbox.checked;
            document.querySelectorAll('input[name^="afficher_rubrique-"]').forEach(cb => {
                const tocItem = cb.closest('.toc-item');
                if (tocItem && tocItem.style.display !== 'none') {
                    cb.checked = checked;
                    const id = cb.name.replace('afficher_rubrique-', '');
                    setRubriqueVisibility(id, checked);
                }
            });
        });

            toggleIcon?.addEventListener('click', () => {
                sidebar?.classList.toggle('collapsed');

                toggleIcon.classList.toggle('icon-chevron-up');
                toggleIcon.classList.toggle('icon-chevron-down');
        });

            document.querySelectorAll('#tocModal .toc-sidebar a[href^="#"]').forEach(link => {
                link.addEventListener('click', () => {
                    $('#tocModal').modal('hide');
                });
            });

        updateSelectAll();
    })();
</script>


<script type='text/javascript'>
    $(document).ready(function() {
	    var dialogRecupEffectifsDegagements = $('<div style="display:none;"></div>').appendTo('body');

        // Fonction helper pour gérer l'état de chargement du dropdown
        function setDropdownLoading(isLoading, loadingText) {
            var $btn = $('#btnRepriseDropdown');
            var $caret = $btn.find('.caret');

            if (isLoading) {
                // Sauvegarder le texte original
                $btn.data('original-text', $btn.html());

                // Désactiver le bouton et afficher le texte de chargement
                $btn.prop('disabled', true)
                    .addClass('disabled')
                $btn.html(loadingText + ' <img src="/images/load.gif" style="height:14px;margin-left:5px;" />');

                // Fermer le dropdown s'il est ouvert
                $('.btn-group').removeClass('open');
            } else {
                // Restaurer le texte original
                var originalText = $btn.data('original-text');
                if (originalText) {
                    $btn.html(originalText);
                }

                // Réactiver le bouton
                $btn.prop('disabled', false)
                    .removeClass('disabled');
            }
        }

        dialogRecupEffectifsDegagements.dialog({
            title: "Reprise des données d'un dossier précédent",
            modal: true,
            autoOpen: false,
            width: 1200,
            height: 'auto',
            buttons: [
                {
                    text: 'Reprendre les effectifs et dégagements',
                    class: 'btn btn-success',
                    click: function() {
                        if ($('input[type=radio][name=dossierSelect]:checked').length == 1) {
                            $.ajax({
                                type: "POST",
                                url: "/dossier/recupeffectifsdegagements",
                                data: $("#selectionDossier").serialize(),
                                beforeSend: function(){
                                    dialogRecupEffectifsDegagements.html("Veuillez patienter pendant la reprise des effectifs et dégagements <img src='/images/load.gif' />");
                                },
                                success: function() {
                                    window.location='/dossier/effectifs-degagements-dossier/id/'+$("#idDossier").val();
                                },
                                error: function() {
                                    alert('Erreur lors de la reprise des données. Veuillez réessayer.');
                                    dialogRecupEffectifsDegagements.dialog("close");
                                }
                            });
                        } else {
                            return false;
                        }

                        return false;
                    }
                },
                {
                    text: 'Annuler',
                    class: 'btn',
                    click: function() {
                        $(this).html("");
                        $(this).dialog("close");
                    }
                }
            ],
        });

        $(document).on('click', '#recupEffectifsDegagementsDossier', function(event) {
            event.preventDefault();

            $.ajax({
                type: "POST",
                url: "/dossier/formrecupeffectifsdegagements",
                data: {idDossier: $("#idDossier").val()},
                success: function(msg) {
                    dialogRecupEffectifsDegagements.html(msg);
                    dialogRecupEffectifsDegagements.dialog("open");
                },
                error: function() {
                    alert('Erreur lors du chargement du formulaire. Veuillez réessayer.');
                }
            });

            return false;
        });

        $(document).on('click', '#copyToEtablissement', function(event) {
            event.preventDefault();

            // Afficher l'état de chargement
            setDropdownLoading(true, 'Copie en cours...');

            $.ajax({
                type: "POST",
                url: "/dossier/copier-effectifs-degagements-etablissement",
                data: {idDossier: $("#idDossier").val()},
                success: function() {
                    // Rediriger vers la page avec le flash message
                    window.location='/dossier/effectifs-degagements-dossier/id/'+$("#idDossier").val();
                },
                error: function() {
                    // Restaurer l'état du bouton en cas d'erreur
                    setDropdownLoading(false);
                    alert('Erreur lors de la copie des données. Veuillez réessayer.');
                }
            });

            return false;
        });

        $(document).on('click', '#copyFromEtablissement', function(event) {
            event.preventDefault();

            // Afficher l'état de chargement
            setDropdownLoading(true, 'Reprise en cours...');

            $.ajax({
                type: "POST",
                url: "/dossier/recuperer-effectifs-degagements-etablissement",
                data: {idDossier: $("#idDossier").val()},
                success: function() {
                    // Rediriger vers la page avec le flash message
                    window.location='/dossier/effectifs-degagements-dossier/id/'+$("#idDossier").val();
                },
                error: function() {
                    // Restaurer l'état du bouton en cas d'erreur
                    setDropdownLoading(false);
                    alert('Erreur lors de la reprise des données. Veuillez réessayer.');
                }
            });

            return false;
        });
    });
</script>
